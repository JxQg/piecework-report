@page
@model SpecificationsModel
@{ ViewData["Title"] = "物料规格"; }
<div class="page-heading"><div><p class="eyebrow">NON-STANDARD PRODUCTS</p><h1>物料规格</h1><p>扣数属于规格；机器仅决定该规格能否加工。</p></div><div class="action-row"><a asp-page="/Imports" asp-route-kind="specification" class="btn btn-outline-secondary">导入规格</a></div></div>
@if (!string.IsNullOrWhiteSpace(Model.FlashMessage)) { <div class="alert alert-success">@Model.FlashMessage</div> }
<section class="section-block"><div class="section-heading"><div><h2>@(Model.Input.Id == 0 ? "新增规格" : "编辑规格")</h2><p>规格编码生成后不可修改。</p></div></div>
<form method="post" asp-page-handler="Save" class="stack-form"><input asp-for="Input.Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="field-error"></div>
<div class="form-grid two-cols"><div><label class="form-label">规格编码</label><input value="@Model.Input.Code" class="form-control" readonly /></div><div><label asp-for="Input.MaterialId" class="form-label">所属物料</label><select asp-for="Input.MaterialId" class="form-select" disabled="@(Model.Input.Id != 0)">@foreach(var item in Model.Materials){<option value="@item.Id">@item.Code · @item.Name</option>}</select>@if(Model.Input.Id != 0){<input asp-for="Input.MaterialId" type="hidden" />}</div><div><label asp-for="Input.Description" class="form-label">规格描述</label><input asp-for="Input.Description" class="form-control" /></div><div><label asp-for="Input.BuckleCount" class="form-label">每件扣数</label><input asp-for="Input.BuckleCount" class="form-control" step="0.001" /></div><div class="full-row"><label asp-for="Input.Note" class="form-label">备注</label><input asp-for="Input.Note" class="form-control" /></div></div>
<div><label class="form-label">可加工机器</label><div class="check-grid">@foreach(var machine in Model.Machines){<label class="form-check"><input type="checkbox" name="Input.MachineIds" value="@machine.Id" checked="@Model.Input.MachineIds.Contains(machine.Id)" class="form-check-input" /> @machine.Code · @machine.Name</label>}</div></div>
<label class="form-check"><input asp-for="Input.IsActive" class="form-check-input" /> 在用</label><div class="action-row"><button class="btn btn-primary">保存规格</button><a asp-page="/Specifications" class="btn btn-outline-secondary">清空</a></div></form></section>
<section class="section-block"><div class="section-heading"><div><h2>规格列表</h2><p>@Model.Specifications.Count 个规格</p></div><form method="get" class="period-picker"><label>物料筛选</label><select name="materialId" class="form-select" onchange="this.form.submit()"><option value="">全部物料</option>@foreach(var item in Model.Materials){<option value="@item.Id" selected="@(Request.Query["materialId"] == item.Id.ToString())">@item.Code · @item.Name</option>}</select></form></div>
<div class="table-responsive"><table class="data-table"><thead><tr><th>规格编码</th><th>物料</th><th>规格描述</th><th class="number">扣数</th><th>可加工机器</th><th>状态</th><th></th></tr></thead><tbody>@foreach(var item in Model.Specifications){<tr class="@(!item.IsActive ? "is-inactive" : "")"><td>@item.Code</td><td><strong>@item.Material.Name</strong><small>@item.Material.Code</small></td><td>@item.Description</td><td class="number">@item.BuckleCount.ToString("N3")</td><td>@string.Join("、", item.Machines.Where(x => x.IsActive).Select(x => x.Machine.Name))</td><td>@(item.IsActive ? "在用" : "停用")</td><td class="actions"><a asp-route-editId="@item.Id" asp-route-materialId="@item.MaterialId" class="btn btn-sm btn-outline-secondary">编辑</a></td></tr>}</tbody></table></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
