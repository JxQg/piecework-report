@page
@model ProductionModel
@{ ViewData["Title"] = "每日计件"; }
<div class="page-heading"><div><p class="eyebrow">DAILY INPUT</p><h1>每日计件</h1><p>按配置工作日、员工和机器规格记录完成件数。</p></div>@if(Model.Periods.Count>0){<form method="get" class="period-picker date-picker"><select name="periodId" class="form-select">@foreach(var period in Model.Periods){<option value="@period.Id" selected="@(period.Id==Model.SelectedPeriod?.Id)">@period.DisplayName</option>}</select><select name="workDate" class="form-select">@foreach(var day in Model.Workdays){<option value="@day.ToString("yyyy-MM-dd")" selected="@(day==Model.Input.WorkDate)">@day.ToString("MM月dd日")</option>}</select><button class="btn btn-outline-secondary">查看</button></form>}</div>
@if(!string.IsNullOrWhiteSpace(Model.FlashMessage)){<div class="alert alert-success">@Model.FlashMessage</div>}
@if(Model.SelectedPeriod is null){<section class="empty-state"><h2>尚未创建工资月份</h2></section>}else if(Model.Workdays.Count==0){<section class="empty-state"><h2>本月尚未配置工作日</h2>@if(User.IsInRole("Manager")){<a asp-page="/Periods" asp-route-editId="@Model.SelectedPeriod.Id" class="btn btn-primary">配置工作日</a>}</section>}else{
<section class="section-block"><form method="post" asp-page-handler="Save" class="inline-editor production-v2-editor"><input asp-for="Input.PeriodId" type="hidden"/><div asp-validation-summary="ModelOnly" class="field-error full-row"></div><div><label asp-for="Input.WorkDate">日期</label><select asp-for="Input.WorkDate" class="form-select">@foreach(var day in Model.Workdays){<option value="@day.ToString("yyyy-MM-dd")">@day.ToString("yyyy-MM-dd")</option>}</select></div><div><label asp-for="Input.EmployeeId">员工</label><select asp-for="Input.EmployeeId" class="form-select"><option value="">请选择</option>@foreach(var item in Model.Employees){<option value="@item.Id">@item.Code · @item.Name</option>}</select></div><div><label asp-for="Input.MachineSpecificationId">机器 / 规格</label><select asp-for="Input.MachineSpecificationId" class="form-select"><option value="">请选择</option>@foreach(var item in Model.MachineSpecifications){<option value="@item.Id">@item.Machine.Name / @item.MaterialSpecification.Material.Name · @item.MaterialSpecification.Description (@item.MaterialSpecification.Code)</option>}</select></div><div><label asp-for="Input.Quantity">完成件数</label><input asp-for="Input.Quantity" class="form-control" step="0.001"/></div><div><label asp-for="Input.Note">备注</label><input asp-for="Input.Note" class="form-control"/></div><button class="btn btn-primary">保存计件</button></form></section>
@if(User.IsInRole("Manager")){<section class="report-strip manager-money"><div><span>当日达标率</span><strong>@((Model.ManagerDailyAttainment??0).ToString("P2"))</strong></div><div><span>当日计件工资</span><strong>¥@((Model.ManagerDailyWage??0).ToString("N2"))</strong></div></section>}
<section class="section-block"><div class="section-heading"><div><h2>@Model.Input.WorkDate.ToString("MM月dd日") 计件明细</h2><p>@Model.Records.Count 条记录</p></div></div><div class="table-responsive"><table class="data-table"><thead><tr><th>员工</th><th>机器</th><th>物料 / 规格</th><th class="number">完成件数</th>@if(User.IsInRole("Manager")){<th class="number manager-money">每件单价</th><th class="number manager-money">达标率</th><th class="number manager-money">计件工资</th>}<th>备注</th><th></th></tr></thead><tbody>@foreach(var item in Model.Records){<tr><td><strong>@item.EmployeeName</strong><small>@item.EmployeeCode</small></td><td><strong>@item.MachineName</strong><small>@item.MachineCode</small></td><td><strong>@item.MaterialName · @item.Specification</strong><small>@item.SpecificationCode</small></td><td class="number">@item.Quantity.ToString("N3")</td>@if(User.IsInRole("Manager")){<td class="number manager-money">@item.PieceRate?.ToString("N6")</td><td class="number manager-money">@item.AttainmentRate?.ToString("P2")</td><td class="number manager-money">@item.Wage?.ToString("N2")</td>}<td>@item.Note</td><td class="actions"><form method="post" asp-page-handler="Delete"><input name="id" value="@item.Id" type="hidden"/><input name="periodId" value="@Model.SelectedPeriod.Id" type="hidden"/><input name="workDate" value="@Model.Input.WorkDate.ToString("yyyy-MM-dd")" type="hidden"/><button class="btn btn-sm btn-outline-danger">删除</button></form></td></tr>}</tbody></table></div></section>}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
