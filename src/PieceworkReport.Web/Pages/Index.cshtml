@page
@model IndexModel
@{ ViewData["Title"] = "总览"; }
<div class="page-heading"><div><p class="eyebrow">MONTHLY CONTROL</p><h1>@(User.IsInRole("Manager") ? "工资总览" : "计件录入总览")</h1></div>@if(Model.Periods.Count>0){<form method="get" class="period-picker"><label>工资月份</label><select name="periodId" class="form-select" onchange="this.form.submit()">@foreach(var period in Model.Periods){<option value="@period.Id" selected="@(period.Id==Model.SelectedPeriod?.Id)">@period.DisplayName</option>}</select></form>}</div>
@if(Model.SelectedPeriod is null){<section class="empty-state"><h2>尚未创建工资月份</h2>@if(User.IsInRole("Manager")){<a asp-page="/Periods" class="btn btn-primary">创建月份</a>}</section>}
else if(!User.IsInRole("Manager")){
<section class="kpi-grid"><article class="kpi-card"><span>当前月份</span><strong>@Model.SelectedPeriod.DisplayName</strong><small>@Model.WorkdayCount 个配置工作日</small></article><article class="kpi-card"><span>本月录入</span><strong>@Model.ProductionRecordCount</strong><small>条计件明细</small></article><article class="kpi-card"><span>今日录入</span><strong>@Model.TodayRecordCount</strong><small>条计件明细</small></article><article class="kpi-card @(Model.PendingSpecificationCount>0?"kpi-alert":"kpi-positive")"><span>待处理规格</span><strong>@Model.PendingSpecificationCount</strong><small>尚未配置可加工机器</small></article></section>
<section class="section-block"><div class="section-heading"><div><h2>日常录入</h2><p>选择工作日后录入员工完成件数。</p></div></div><div class="action-row"><a asp-page="/Production" asp-route-periodId="@Model.SelectedPeriod.Id" class="btn btn-primary">进入每日计件</a><a asp-page="/Imports" class="btn btn-outline-secondary">Excel 批量导入</a></div></section>
}
else if(Model.ManagerPeriod is not null && Model.ManagerReport is not null){
<section class="kpi-grid"><article class="kpi-card kpi-budget"><span>上级预算</span><strong>¥@Model.ManagerPeriod.Budget.ToString("N2")</strong><small>@Model.ManagerPeriod.PlannedWorkdays 天 · @Model.ManagerPeriod.PlannedHeadcount 人</small></article><article class="kpi-card"><span>预算建议日工资</span><strong>¥@Model.ManagerPeriod.TargetDailyWage.ToString("N2")</strong><small>仅用于制定单价</small></article><article class="kpi-card"><span>实际计件工资</span><strong>¥@Model.ManagerReport.PieceworkTotal.ToString("N2")</strong><small>@Model.ProductionRecordCount 条生产记录</small></article><article class="kpi-card @(Model.ManagerReport.PieceworkVariance>0?"kpi-alert":"kpi-positive")"><span>计件预算偏差</span><strong>@(Model.ManagerReport.PieceworkVariance>=0?"+":"")¥@Model.ManagerReport.PieceworkVariance.ToString("N2")</strong><small>预算不限制工资</small></article></section>
<section class="split-layout"><div class="section-block"><div class="section-heading"><div><h2>员工工资</h2><p>月计件工资统一取整一次后累加增项</p></div><a asp-page="/Reports" asp-route-periodId="@Model.SelectedPeriod.Id" class="btn btn-sm btn-outline-secondary">完整报表</a></div><div class="table-responsive"><table class="data-table"><thead><tr><th>员工</th><th class="number">计件</th><th class="number">增项</th><th class="number">合计</th></tr></thead><tbody>@foreach(var item in Model.ManagerReport.EmployeeRows.Take(10)){<tr><td><strong>@item.EmployeeName</strong><small>@item.EmployeeCode</small></td><td class="number">@item.PieceworkWage.ToString("N2")</td><td class="number">@item.AdjustmentAmount.ToString("N2")</td><td class="number total">@item.TotalWage.ToString("N2")</td></tr>}</tbody></table></div></div><aside class="section-block"><div class="section-heading"><div><h2>数据状态</h2></div></div><dl class="status-list"><div><dt>计价规则</dt><dd>@Model.PricingRuleCount 条</dd></div><div><dt>工资增项</dt><dd>¥@Model.ManagerReport.AdjustmentTotal.ToString("N2")</dd></div><div><dt>最终工资</dt><dd>¥@Model.ManagerReport.FinalTotal.ToString("N2")</dd></div><div><dt>导出状态</dt><dd><span class="status-chip @(Model.ManagerPeriod.ExportOutdated?"status-warning":"status-ok")">@(Model.ManagerPeriod.ExportOutdated?"需要重新导出":"已是最新")</span></dd></div></dl>@if(Model.ManagerReport.Issues.Count>0){<div class="alert alert-warning compact-alert">存在 @Model.ManagerReport.Issues.Count 个计价问题。</div>}<div class="action-row"><a asp-page="/Production" asp-route-periodId="@Model.SelectedPeriod.Id" class="btn btn-primary">查看计件</a><a asp-page="/Pricing" asp-route-periodId="@Model.SelectedPeriod.Id" class="btn btn-outline-secondary">维护计价</a></div></aside></section>
}
