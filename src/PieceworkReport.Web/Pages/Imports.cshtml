@page
@model ImportsModel
@{
    ViewData["Title"] = "Excel 导入";
    var isSpecification = Model.Kind == "specification";
    var isEmployee = Model.Kind == "employee";
    var valid = Model.Kind switch { "specification" => Model.SpecificationPreview?.IsValid == true, "employee" => Model.EmployeePreview?.IsValid == true, _ => Model.ProductionPreview?.IsValid == true };
}
<div class="page-heading"><div><p class="eyebrow">BATCH IMPORT</p><h1>Excel 导入</h1><p>模板、预览、整批提交；任何一行错误都会拒绝整批数据。</p></div><div class="segmented"><a asp-route-kind="production" class="@(!isSpecification&&!isEmployee?"active":"")">计件明细</a><a asp-route-kind="employee" class="@(isEmployee?"active":"")">员工</a><a asp-route-kind="specification" class="@(isSpecification?"active":"")">物料规格</a></div></div>
@if(!string.IsNullOrWhiteSpace(Model.FlashMessage)){<div class="alert alert-success">@Model.FlashMessage</div>}
<section class="section-block upload-band"><div class="section-heading"><div><h2>@(isSpecification?"导入物料规格":isEmployee?"导入员工":"导入每日计件")</h2><p>@(isSpecification?"可向已有物料追加规格，也可按唯一物料名称批量新建。":isEmployee?"按员工编码新增或更新；状态留空时默认为在用。":"使用规格编码录入，系统校验工作日、机器适配与计价配置。")</p></div><a asp-page-handler="Template" asp-route-kind="@Model.Kind" class="btn btn-outline-secondary">下载模板</a></div><form method="post" enctype="multipart/form-data" asp-page-handler="Preview" class="upload-form"><input asp-for="Kind" type="hidden"/><div><label asp-for="Upload" class="form-label">选择 .xlsx 文件</label><input asp-for="Upload" class="form-control" accept=".xlsx"/></div><button class="btn btn-primary">预览校验</button></form></section>
<div asp-validation-summary="ModelOnly" class="validation-list"></div>
@if(isSpecification && Model.SpecificationPreview is not null){
<section class="section-block"><div class="section-heading"><div><h2>规格预览</h2><p>@Model.SpecificationPreview.Rows.Count 行可提交，@Model.SpecificationPreview.Errors.Count 个错误</p></div></div>@if(Model.SpecificationPreview.Errors.Count>0){<div class="validation-list"><ul>@foreach(var error in Model.SpecificationPreview.Errors){<li>@error</li>}</ul></div>}<div class="table-responsive"><table class="data-table"><thead><tr><th>行</th><th>物料</th><th>规格描述</th><th class="number">扣数</th><th>可加工机器</th><th>备注</th></tr></thead><tbody>@foreach(var row in Model.SpecificationPreview.Rows){<tr><td>@row.RowNumber</td><td><strong>@row.MaterialName</strong><small>@(row.MaterialCode??"自动新建")</small></td><td>@row.Description</td><td class="number">@row.BuckleCount.ToString("N3")</td><td>@string.Join("、",row.MachineCodes)</td><td>@row.Note</td></tr>}</tbody></table></div></section>}
else if(isEmployee && Model.EmployeePreview is not null){
<section class="section-block"><div class="section-heading"><div><h2>员工预览</h2><p>@Model.EmployeePreview.Rows.Count 行可提交，@Model.EmployeePreview.Errors.Count 个错误</p></div></div>@if(Model.EmployeePreview.Errors.Count>0){<div class="validation-list"><ul>@foreach(var error in Model.EmployeePreview.Errors){<li>@error</li>}</ul></div>}<div class="table-responsive"><table class="data-table"><thead><tr><th>行</th><th>员工编码</th><th>姓名</th><th>状态</th><th>操作</th></tr></thead><tbody>@foreach(var row in Model.EmployeePreview.Rows){<tr><td>@row.RowNumber</td><td><strong>@row.Code</strong></td><td>@row.Name</td><td>@(row.IsActive?"在用":"停用")</td><td><span class="status-chip @(row.Action=="新增"?"status-ok":row.Action=="更新"?"status-warning":"")">@row.Action</span></td></tr>}</tbody></table></div></section>}
else if(!isSpecification && !isEmployee && Model.ProductionPreview is not null){
<section class="section-block"><div class="section-heading"><div><h2>计件预览</h2><p>@Model.ProductionPreview.Rows.Count 行可提交，@Model.ProductionPreview.Errors.Count 个错误</p></div></div>@if(Model.ProductionPreview.Errors.Count>0){<div class="validation-list"><ul>@foreach(var error in Model.ProductionPreview.Errors){<li>@error</li>}</ul></div>}<div class="table-responsive"><table class="data-table"><thead><tr><th>行</th><th>日期</th><th>员工</th><th>机器</th><th>物料 / 规格</th><th class="number">完成件数</th><th>备注</th></tr></thead><tbody>@foreach(var row in Model.ProductionPreview.Rows){<tr><td>@row.RowNumber</td><td>@row.WorkDate.ToString("yyyy-MM-dd")</td><td><strong>@row.EmployeeName</strong><small>@row.EmployeeCode</small></td><td><strong>@row.MachineName</strong><small>@row.MachineCode</small></td><td><strong>@row.MaterialName · @row.Specification</strong><small>@row.SpecificationCode</small></td><td class="number">@row.Quantity.ToString("N3")</td><td>@row.Note</td></tr>}</tbody></table></div></section>}
@if(valid){<form method="post" asp-page-handler="Confirm" class="action-row"><input asp-for="Token" type="hidden"/><input asp-for="Kind" type="hidden"/><button class="btn btn-primary">确认整批导入</button></form>}
