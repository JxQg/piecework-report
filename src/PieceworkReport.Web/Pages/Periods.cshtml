@page
@model PeriodsModel
@{ ViewData["Title"] = "工资月份"; }
<div class="page-heading"><div><p class="eyebrow">BUDGET BASELINE</p><h1>工资月份</h1><p>预算只用于制定单价和观察偏差；计划工作日等于勾选的实际日期数。</p></div></div>
@if(!string.IsNullOrWhiteSpace(Model.FlashMessage)){<div class="alert alert-success">@Model.FlashMessage</div>}
<div class="form-layout"><section class="section-block"><div class="section-heading"><div><h2>@(Model.Input.Id==0?"新建月份":"编辑月份")</h2></div></div><form method="post" asp-page-handler="Save" class="stack-form"><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="field-error"></div><div class="form-grid two-cols"><div><label asp-for="Input.Year" class="form-label">年份</label><input asp-for="Input.Year" class="form-control"/></div><div><label asp-for="Input.Month" class="form-label">月份</label><input asp-for="Input.Month" class="form-control"/></div><div><label asp-for="Input.Budget" class="form-label">上级预算</label><input asp-for="Input.Budget" class="form-control" step="0.01"/></div><div><label asp-for="Input.PlannedHeadcount" class="form-label">计划人数</label><input asp-for="Input.PlannedHeadcount" class="form-control"/></div></div><div><label class="form-label">实际工作日（@Model.Input.SelectedDays.Count 天）</label><div class="day-grid">@foreach(var day in Model.MonthDays){var date=new DateTime(Model.Input.Year,Model.Input.Month,day);<label class="day-check"><input type="checkbox" name="Input.SelectedDays" value="@day" checked="@Model.Input.SelectedDays.Contains(day)"/><span>@day<small>@date.ToString("ddd")</small></span></label>}</div></div><div class="action-row"><button class="btn btn-primary">保存月份</button><a asp-page="/Periods" class="btn btn-outline-secondary">清空</a></div></form></section>
<section class="section-block"><div class="section-heading"><div><h2>月份列表</h2></div></div><div class="table-responsive"><table class="data-table"><thead><tr><th>月份</th><th class="number">预算</th><th class="number">建议日工资</th><th>状态</th><th></th></tr></thead><tbody>@foreach(var period in Model.Periods){<tr><td><strong>@period.DisplayName</strong><small>@period.PlannedWorkdays 天 · @period.PlannedHeadcount 人</small></td><td class="number">¥@period.Budget.ToString("N2")</td><td class="number">¥@period.TargetDailyWage.ToString("N2")</td><td><span class="status-chip @(period.ExportOutdated?"status-warning":"status-ok")">@(period.ExportOutdated?"数据有变更":"已导出")</span></td><td class="actions"><a asp-route-editId="@period.Id" class="btn btn-sm btn-outline-secondary">编辑</a></td></tr>}</tbody></table></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
