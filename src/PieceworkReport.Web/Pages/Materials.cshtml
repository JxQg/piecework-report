@page
@model MaterialsModel
@{ ViewData["Title"] = "物料管理"; }
<div class="page-heading"><div><p class="eyebrow">MASTER DATA</p><h1>物料管理</h1><p>物料仅表示产品类别，非标规格在规格菜单单独维护。</p></div></div>
@if (!string.IsNullOrWhiteSpace(Model.FlashMessage)) { <div class="alert alert-success">@Model.FlashMessage</div> }
<div class="form-layout"><section class="section-block"><div class="section-heading"><div><h2>@(Model.Input.Id == 0 ? "新增物料" : "编辑物料")</h2></div></div><form method="post" asp-page-handler="Save" class="stack-form"><input asp-for="Input.Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="field-error"></div><div><label class="form-label">物料编码</label><input value="@Model.Input.Code" class="form-control" readonly /></div><div><label asp-for="Input.Name" class="form-label">物料名称</label><input asp-for="Input.Name" class="form-control" /></div><label class="form-check"><input asp-for="Input.IsActive" class="form-check-input" /> 在用</label><div class="action-row"><button class="btn btn-primary">保存</button><a asp-page="/Materials" class="btn btn-outline-secondary">清空</a></div></form></section>
<section class="section-block"><div class="section-heading"><div><h2>物料列表</h2><p>@Model.Materials.Count 类物料</p></div></div><div class="table-responsive"><table class="data-table"><thead><tr><th>编码</th><th>名称</th><th class="number">规格数</th><th>状态</th><th></th></tr></thead><tbody>@foreach(var item in Model.Materials){<tr class="@(!item.IsActive ? "is-inactive" : "")"><td>@item.Code</td><td><strong>@item.Name</strong></td><td class="number">@item.Specifications.Count</td><td>@(item.IsActive ? "在用" : "停用")</td><td class="actions"><a asp-route-editId="@item.Id" class="btn btn-sm btn-outline-secondary">编辑</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除该物料及未使用规格？已有业务记录的物料只能停用。')"><input type="hidden" name="id" value="@item.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">删除</button></form></td></tr>}</tbody></table></div></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
