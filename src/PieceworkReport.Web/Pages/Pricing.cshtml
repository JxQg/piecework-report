@page
@using PieceworkReport.Core.Data
@using PieceworkReport.Core.Services
@using PieceworkReport.Web.Services
@model PricingModel
@{ ViewData["Title"] = "经理计价"; }
<div class="page-heading"><div><p class="eyebrow">MANAGER ONLY</p><h1>经理计价</h1><p>预算只提供默认达标工资；实际规则按月份、机器和规格维护。</p></div>@if(Model.Periods.Count>0){<form method="get" class="period-picker"><label>工资月份</label><select name="periodId" class="form-select" onchange="this.form.submit()">@foreach(var period in Model.Periods){<option value="@period.Id" selected="@(period.Id==Model.SelectedPeriod?.Id)">@period.DisplayName</option>}</select></form>}</div>
@if (!string.IsNullOrWhiteSpace(Model.FlashMessage)) { <div class="alert alert-success">@Model.FlashMessage</div> }
@if(Model.SelectedPeriod is null){<section class="empty-state"><h2>尚未创建工资月份</h2><a asp-page="/Periods" class="btn btn-primary">创建月份</a></section>}else{
<section class="section-block"><div class="section-heading"><div><h2>@(Model.Input.Id==0?"新增计价规则":"编辑计价规则")</h2><p>预算建议达标工资：¥@Model.SelectedPeriod.TargetDailyWage.ToString("N2")；直接单价模式下，达标工资和每扣单价仅作核算参考。</p></div></div><form method="post" asp-page-handler="Save" class="stack-form"><input asp-for="Input.Id" type="hidden" /><input asp-for="Input.PeriodId" type="hidden" /><div asp-validation-summary="All" class="field-error"></div><div class="form-grid pricing-form"><div><label asp-for="Input.MachineSpecificationId" class="form-label">机器规格</label><select asp-for="Input.MachineSpecificationId" class="form-select"><option value="">请选择</option>@foreach(var link in Model.MachineSpecifications){<option value="@link.Id">@link.Machine.Code · @link.Machine.Name / @link.MaterialSpecification.Code · @link.MaterialSpecification.Description</option>}</select><span asp-validation-for="Input.MachineSpecificationId" class="field-error"></span></div><div><label asp-for="Input.Mode" class="form-label">计价模式</label><select asp-for="Input.Mode" class="form-select"><option value="@PricingMode.AttainmentBased">达标计价</option><option value="@PricingMode.DirectPieceRate">直接单价</option></select></div><div><label asp-for="Input.TargetDailyWage" class="form-label">达标工资</label><input asp-for="Input.TargetDailyWage" class="form-control" step="0.000001" /><span asp-validation-for="Input.TargetDailyWage" class="field-error"></span></div><div><label asp-for="Input.DefaultTargetBuckleCount" class="form-label">默认达标扣数</label><input asp-for="Input.DefaultTargetBuckleCount" class="form-control" step="0.001" /><span asp-validation-for="Input.DefaultTargetBuckleCount" class="field-error"></span></div><div><label asp-for="Input.DirectPieceRate" class="form-label">直接每件单价</label><input asp-for="Input.DirectPieceRate" class="form-control" step="0.000001" /><span asp-validation-for="Input.DirectPieceRate" class="field-error"></span></div><div><label asp-for="Input.Note" class="form-label">备注</label><input asp-for="Input.Note" class="form-control" /><span asp-validation-for="Input.Note" class="field-error"></span></div></div><div class="action-row"><button class="btn btn-primary">保存规则</button><a asp-route-periodId="@Model.SelectedPeriod.Id" class="btn btn-outline-secondary">清空</a></div></form></section>
<section class="section-block"><div class="section-heading"><div><h2>计价规则</h2><p>@Model.Rules.Count 条规则</p></div></div><div class="table-responsive"><table class="data-table dense-table"><thead><tr><th>机器</th><th>物料 / 规格</th><th>模式</th><th class="number">达标工资</th><th class="number">默认达标扣数</th><th class="number">每扣单价</th><th class="number">每件单价</th><th>员工覆盖</th><th></th></tr></thead><tbody>@foreach(var rule in Model.Rules){var spec=rule.MachineSpecification!.MaterialSpecification;var target=rule.DefaultTargetBuckleCount??0;var targetWage=rule.TargetDailyWage??Model.SelectedPeriod.TargetDailyWage;var buckleRate=PricingMath.BuckleRate(targetWage,target);var pieceRate=PricingMath.PieceRate(rule,spec,target);<tr><td><strong>@rule.MachineSpecification.Machine.Name</strong><small>@rule.MachineSpecification.Machine.Code</small></td><td><strong>@spec.Material.Name · @spec.Description</strong><small>@spec.Code / @spec.BuckleCount.ToString("N3") 扣</small></td><td>@(rule.Mode==PricingMode.AttainmentBased?"达标计价":"直接单价")</td><td class="number">@targetWage.ToString("N2")</td><td class="number">@target.ToString("N3")</td><td class="number">@(target>0?buckleRate.ToString("N6"):"-")</td><td class="number">@pieceRate.ToString("N6")</td><td>@foreach(var item in rule.EmployeeOverrides){<span class="status-chip">@item.Employee.Name @item.TargetBuckleCount.ToString("N0")</span>}</td><td class="actions"><a asp-route-periodId="@Model.SelectedPeriod.Id" asp-route-editId="@rule.Id" class="btn btn-sm btn-outline-secondary">编辑</a><form method="post" asp-page-handler="Delete" onsubmit="return confirm('确定删除该计价规则？已有对应计件记录的规则不能删除。')"><input type="hidden" name="id" value="@rule.Id" /><input type="hidden" name="periodId" value="@Model.SelectedPeriod.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">删除</button></form></td></tr>}</tbody></table></div></section>
@if(Model.Input.Id!=0){var selectedRule=Model.Rules.SingleOrDefault(x=>x.Id==Model.Input.Id);<section class="section-block"><div class="section-heading"><div><h2>员工达标数覆盖</h2><p>仅覆盖默认达标扣数，不改变达标工资。</p></div></div><form method="post" asp-page-handler="SaveOverride" class="inline-editor override-editor"><input name="Override.PeriodId" value="@Model.SelectedPeriod.Id" type="hidden" /><input name="Override.RuleId" value="@Model.Input.Id" type="hidden" /><div><label class="form-label">员工</label><select name="Override.EmployeeId" class="form-select">@foreach(var employee in Model.Employees){<option value="@employee.Id">@employee.Code · @employee.Name</option>}</select></div><div><label class="form-label">达标扣数</label><input name="Override.TargetBuckleCount" class="form-control" type="number" min="0.001" step="0.001" /></div><button class="btn btn-primary">保存覆盖</button></form>@if(selectedRule is not null){<div class="top-gap">@foreach(var item in selectedRule.EmployeeOverrides){<form method="post" asp-page-handler="DeleteOverride" class="list-row"><span><strong>@item.Employee.Name</strong><small>@item.TargetBuckleCount.ToString("N3") 扣</small></span><input name="id" value="@item.Id" type="hidden"/><input name="periodId" value="@Model.SelectedPeriod.Id" type="hidden"/><button class="btn btn-sm btn-outline-danger">删除</button></form>}</div>}</section>}
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
}
